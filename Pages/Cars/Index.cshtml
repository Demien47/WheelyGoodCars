@page
@model WheelyGoodCars.Pages.Cars.IndexModel

<h1>Mijn Auto's</h1>

<a asp-page="Create" class="btn btn-primary mb-3">Nieuwe auto</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Kenteken</th>
            <th>Merk</th>
            <th>Model</th>
            <th>Prijs</th>
            <th>Status</th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var car in Model.Cars)
        {
            <tr>
                <td>@car.LicensePlate</td>
                <td>@car.Brand</td>
                <td>@car.Model</td>
                <td>€ @car.Price</td>
                <td>@(car.IsSold ? "Verkocht" : "Te koop")</td>
                <td>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@car.Id">
                        <button type="submit" class="btn btn-danger btn-sm">Verwijderen</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
