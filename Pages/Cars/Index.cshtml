@page
@model WheelyGoodCars.Pages.Cars.IndexModel

<h1>Auto's</h1>

<a asp-page="Create" class="btn btn-primary mb-3">Nieuwe auto</a>

<div class="mb-3">
    <span class="me-2"><strong>Filter op tag:</strong></span>
    <a asp-page="./Index" class="btn btn-sm @(Model.SelectedTagId == null ? "btn-primary" : "btn-outline-primary") me-1">Alle</a>
    @foreach (var tag in Model.AllTags)
    {
        <a asp-page="./Index" asp-route-tagId="@tag.Id" class="btn btn-sm @(Model.SelectedTagId == tag.Id ? "btn-primary" : "btn-outline-primary") me-1">@tag.Name</a>
    }
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Kenteken</th>
            <th>Merk</th>
            <th>Model</th>
            <th>Prijs</th>
            <th>Tags</th>
            <th>Status</th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var car in Model.Cars)
        {
            <tr>
                <td>@car.LicensePlate</td>
                <td>@car.Brand</td>
                <td>@car.Model</td>
                <td>€ @car.Price</td>
                <td>
                    @if (car.Tags != null && car.Tags.Any())
                    {
                        foreach (var tag in car.Tags)
                        {
                            <span class="badge bg-primary me-1">@tag.Name</span>
                        }
                    }
                </td>
                <td>
                    <button class="btn btn-sm @(car.IsSold ? "btn-success" : "btn-warning") toggle-status-btn"
                            data-car-id="@car.Id">
                        @(car.IsSold ? "Verkocht" : "Te koop")
                    </button>
                </td>

                <td>
                    <a asp-page="Details" asp-route-id="@car.Id" class="btn btn-info btn-sm">
                        Details
                    </a>
                    <a asp-page="Edit" asp-route-id="@car.Id" class="btn btn-primary btn-sm">
                        Bewerken
                    </a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@car.Id" style="display:inline">
                        <button type="submit" class="btn btn-danger btn-sm">Verwijderen</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="mb-3">
        <ul class="pagination">
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-tagId="@(Model.SelectedTagId)">Previous</a>
            </li>

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-page="./Index" asp-route-pageNumber="@p" asp-route-tagId="@(Model.SelectedTagId)">@p</a>
                </li>
            }

            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-tagId="@(Model.SelectedTagId)">Next</a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".toggle-status-btn").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    var carId = this.dataset.carId;
                    var button = this;

                    fetch("?handler=ToggleStatus&id=" + carId, {
                        method: "POST",
                        headers: {
                            "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            button.textContent = data.isSold ? "Verkocht" : "Te koop";
                            button.className = "btn btn-sm " + (data.isSold ? "btn-success" : "btn-warning") + " toggle-status-btn";
                        }
                    });
                });
            });
        });
    </script>
}
