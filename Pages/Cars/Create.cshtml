@page
@model WheelyGoodCars.Pages.Cars.CreateModel
@{
    ViewData["Title"] = "Nieuwe auto";
}

<h2>Nieuwe auto aanbieden</h2>

<form method="post">
    @if (Model.Step == 1)
    {
        <div class="mb-3">
            <label for="LicensePlate" class="form-label">Kenteken</label>
            <input asp-for="Car.LicensePlate" class="form-control" />
        </div>
        <button type="submit" asp-page-handler="Next" class="btn btn-primary">Volgende</button>
    }
    else if (Model.Step == 2)
    {
        <div class="mb-3">
            <label for="Brand" class="form-label">Merk</label>
            <input asp-for="Car.Brand" class="form-control" />
        </div>
        <div class="mb-3">
            <label for="Model" class="form-label">Model</label>
            <input asp-for="Car.Model" class="form-control" />
        </div>
        <div class="mb-3">
            <label for="Year" class="form-label">Bouwjaar</label>
            <input asp-for="Car.Year" class="form-control" type="number" />
        </div>
        <div class="mb-3">
            <label for="Mileage" class="form-label">Kilometerstand</label>
            <input asp-for="Car.Mileage" class="form-control" type="number" />
        </div>
        <div class="mb-3">
            <label for="Price" class="form-label">Vraagprijs</label>
            <input asp-for="Car.Price" class="form-control" type="number" step="0.01" />
        </div>

        <button type="submit" asp-page-handler="Save" class="btn btn-success">Opslaan</button>
    }
</form>
