@page
@model WheelyGoodCars.Pages.Cars.CreateModel
@{
    ViewData["Title"] = "Nieuwe auto";
}

<h2>Nieuwe auto aanbieden</h2>

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Step" />

    @if (Model.Step == 1)
    {
        <div class="mb-3">
            <label asp-for="Car.LicensePlate" class="form-label">Kenteken</label>
            <input asp-for="Car.LicensePlate" class="form-control" />
            <span asp-validation-for="Car.LicensePlate" class="text-danger"></span>
        </div>

        <button type="submit"
                asp-page-handler="Next"
                class="btn btn-primary">
            Volgende
        </button>
    }
    else if (Model.Step == 2)
    {
        <input type="hidden" asp-for="Car.LicensePlate" />

        <div class="mb-3">
            <label asp-for="Car.Brand" class="form-label">Merk</label>
            <input asp-for="Car.Brand" class="form-control" />
            <span asp-validation-for="Car.Brand" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Car.Model" class="form-label">Model</label>
            <input asp-for="Car.Model" class="form-control" />
            <span asp-validation-for="Car.Model" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Car.Year" class="form-label">Bouwjaar</label>
            <input asp-for="Car.Year" type="number" class="form-control" />
            <span asp-validation-for="Car.Year" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Car.Mileage" class="form-label">Kilometerstand</label>
            <input asp-for="Car.Mileage" type="number" class="form-control" />
            <span asp-validation-for="Car.Mileage" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Car.Price" class="form-label">Vraagprijs</label>
            <input asp-for="Car.Price" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Car.Price" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label for="CarImage" class="form-label">Foto uploaden</label>
            <input type="file" name="CarImage" class="form-control" />
        </div>

        <button type="submit"
                asp-page-handler="Save"
                class="btn btn-success">
            Opslaan
        </button>
        <div style="height: 120px;"></div>
    }
</form>